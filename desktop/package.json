{
  "name": "albertelli-design-studio-desktop",
  "productName": "Albertelli Design Studio",
  "version": "0.4.0",
  "description": "Studio locale per progettazione di interni e catalogo Albertelli Kitchen",
  "author": "Albertelli Design Studio",
  "private": true,
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "stage": "node scripts/stage.cjs",
    "dist:win": "electron-builder --win nsis --x64 --publish never"
  },
  "devDependencies": {
    "electron": "45.0.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "it.albertelli.designstudio",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "main.cjs",
      "runtime.cjs",
      "web-runner.cjs",
      "backup.cjs",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "staged",
        "to": ".",
        "filter": [
          "api/**/*",
          "web/**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Albertelli-Design-Studio-Setup-${version}-${arch}.${ext}",
      "executableName": "Albertelli Design Studio"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false,
      "shortcutName": "Albertelli Design Studio"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/dimadjdima87/Programmi-arredo.git"
  },
  "license": "UNLICENSED"
}
